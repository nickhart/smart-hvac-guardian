# Environment for a deployed instance. See README → Self-Hosting.
# YoLink and IFTTT credentials are NOT set here — they are entered in the
# setup wizard and stored encrypted per tenant.

# Postgres (Neon) — tenants, users, configuration, encrypted secrets
DATABASE_URL=

# 64 hex chars: `openssl rand -hex 32`. Encrypts tenant secrets at rest.
# Back it up — losing or changing it makes stored credentials unreadable.
MASTER_ENCRYPTION_KEY=

# Upstash Redis (https://console.upstash.com → Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (https://console.upstash.com → QStash)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional — only if the console shows a region-specific URL
QSTASH_URL=

# Magic-link sign-in (https://resend.com)
RESEND_API_KEY=
# Sender address on a domain verified in Resend
EMAIL_FROM=
# Public URL of this deployment, e.g. https://your-app.vercel.app
APP_URL=

# Tinybird analytics (optional — https://tinybird.co)
# Runtime token needs append access only; deploy with a separate admin token.
TINYBIRD_TOKEN=
TINYBIRD_URL=

# Branding (optional)
SITE_NAME=
LOGO_URL=
PRIMARY_COLOR=

# ---------------------------------------------------------------------------
# Legacy single-tenant mode — local dev server only.
# Do NOT set these in a deployed environment; this mode is being removed.
# The dev server reads APP_CONFIG from .env.<name> files (see README → Dev Server).
# ---------------------------------------------------------------------------
# APP_CONFIG=
# YOLINK_UA_CID=
# YOLINK_SECRET_KEY=
# IFTTT_WEBHOOK_KEY=
# OWNER_EMAIL=
